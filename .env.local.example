# Environment Variables — FlavorLens

# ============================================================
# GEMINI AI (Required)
# Get your key at: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# CLERK AUTH (Required)
# Get these at: https://clerk.com → Create Application
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================================
# SUPABASE DATABASE (Required for DB features)
# Get these at: https://supabase.com → New Project → Settings → Database
# ============================================================
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ============================================================
# SUPABASE STORAGE (Optional — for image uploads)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================
# APP URL (Required for production)
# ============================================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
